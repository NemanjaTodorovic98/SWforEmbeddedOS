<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izvođači i žanrovi"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/exitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izlaz"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/artistInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unesite izvođača"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/addArtistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodaj izvođača"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/updateArtistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izmeni izabranog umetnika"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/deleteArtistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obrisi izabranog umetnika"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

    <ListView
            android:id="@+id/artistListView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/genreInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unesite žanr"
            android:layout_marginBottom="2dp" />

        <Button
            android:id="@+id/addGenreButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodaj žanr"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/updateGenreButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izmeni izabrani zanr"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/deleteGenreButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obrisi izabrani zanr"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/genreListView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="4dp" />

        <Button
        android:id="@+id/songsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menazdment pesmama"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="13sp" />

        <Button
        android:id="@+id/playlistsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plejliste"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="13sp" />

        <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pretraga"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="13sp" />

    </LinearLayout>
